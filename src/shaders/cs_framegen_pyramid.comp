#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

#include "descriptor_set.h"

// Pass 1A-Pyr (v8): Ultra-fast 2x RG8_UNORM pyramid downsample (1/4 -> 1/8 -> 1/16 res).
// Builds genuine blurred luma + smoothed 8-bit Census at 1/8 (64 KB) and 1/16 (16 KB) resolution (~0.04ms total).
layout(
  local_size_x = 8,
  local_size_y = 8,
  local_size_z = 1) in;

layout(binding = 0, scalar)
uniform layers_t {
    uint u_dstWidth;
    uint u_dstHeight;
    uint u_srcWidth;
    uint u_srcHeight;
};

// s_samplers[0] = finer RG8_UNORM level (bound linear so R channel bilinearly averages 2x2)
shared float s_pyr[10][10];

void main()
{
    uvec2 lid = gl_LocalInvocationID.xy;
    uint linearId = lid.y * 8u + lid.x;
    ivec2 tileOrigin = ivec2(gl_WorkGroupID.xy * uvec2(8u, 8u));
    vec2 invDst = 1.0 / vec2(u_dstWidth, u_dstHeight);

    for (uint idx = linearId; idx < 100u; idx += 64u)
    {
        uint sy = idx / 10u;
        uint sx = idx % 10u;
        ivec2 p = clamp(tileOrigin + ivec2(int(sx) - 1, int(sy) - 1), ivec2(0), ivec2(int(u_dstWidth) - 1, int(u_dstHeight) - 1));
        vec2 uv = (vec2(p) + 0.5) * invDst;
        s_pyr[sy][sx] = textureLod(s_samplers[0], uv, 0.0).r;
    }
    barrier();

    uvec2 pos = gl_GlobalInvocationID.xy;
    if (pos.x >= u_dstWidth || pos.y >= u_dstHeight)
        return;

    uint cx = lid.x + 1u;
    uint cy = lid.y + 1u;

    float lCenter = (
        1.0 * s_pyr[cy - 1u][cx - 1u] + 2.0 * s_pyr[cy - 1u][cx] + 1.0 * s_pyr[cy - 1u][cx + 1u] +
        2.0 * s_pyr[cy     ][cx - 1u] + 4.0 * s_pyr[cy     ][cx] + 2.0 * s_pyr[cy     ][cx + 1u] +
        1.0 * s_pyr[cy + 1u][cx - 1u] + 2.0 * s_pyr[cy + 1u][cx] + 1.0 * s_pyr[cy + 1u][cx + 1u]
    ) * (1.0 / 16.0);

    const float eps = 0.015;
    uint bits = 0u;
    if (s_pyr[cy - 1u][cx - 1u] > lCenter + eps) bits |= (1u << 0u);
    if (s_pyr[cy - 1u][cx     ] > lCenter + eps) bits |= (1u << 1u);
    if (s_pyr[cy - 1u][cx + 1u] > lCenter + eps) bits |= (1u << 2u);
    if (s_pyr[cy     ][cx - 1u] > lCenter + eps) bits |= (1u << 3u);
    if (s_pyr[cy     ][cx + 1u] > lCenter + eps) bits |= (1u << 4u);
    if (s_pyr[cy + 1u][cx - 1u] > lCenter + eps) bits |= (1u << 5u);
    if (s_pyr[cy + 1u][cx     ] > lCenter + eps) bits |= (1u << 6u);
    if (s_pyr[cy + 1u][cx + 1u] > lCenter + eps) bits |= (1u << 7u);

    imageStore(dst, ivec2(pos), vec4(lCenter, float(bits) * (1.0 / 255.0), 0.0, 1.0));
}
