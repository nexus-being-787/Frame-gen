#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

#include "descriptor_set.h"

// Pass 1A (v8): 1/4-res RG8_UNORM pre-blurred luma + noise-robust adaptive 8-bit Census.
// Fix #5: Computes 3x3 Gaussian-smoothed luma for ALL neighbors first (s_smooth[10][10]) so Census
// compares smoothed neighbors against smoothed center with an adaptive noise-aware threshold (0.015..0.035),
// making Outlast night-vision grain & flicker rock-solid.
layout(
  local_size_x = 8,
  local_size_y = 8,
  local_size_z = 1) in;

layout(binding = 0, scalar)
uniform layers_t {
    uint u_lumaWidth;
    uint u_lumaHeight;
    uint u_fullWidth;
    uint u_fullHeight;
};

shared float s_raw[12][12];
shared float s_smooth[10][10];

float sampleBoxLuma(vec2 uv, vec2 invFull)
{
    vec2 o = invFull * 1.0;
    vec3 c0 = textureLod(s_samplers[0], clamp(uv + vec2(-o.x, -o.y), 0.0, 1.0), 0.0).rgb;
    vec3 c1 = textureLod(s_samplers[0], clamp(uv + vec2( o.x, -o.y), 0.0, 1.0), 0.0).rgb;
    vec3 c2 = textureLod(s_samplers[0], clamp(uv + vec2(-o.x,  o.y), 0.0, 1.0), 0.0).rgb;
    vec3 c3 = textureLod(s_samplers[0], clamp(uv + vec2( o.x,  o.y), 0.0, 1.0), 0.0).rgb;
    return dot(0.25 * (c0 + c1 + c2 + c3), vec3(0.2126, 0.7152, 0.0722));
}

void main()
{
    uvec2 lid = gl_LocalInvocationID.xy;
    uint linearId = lid.y * 8u + lid.x;
    ivec2 tileOrigin = ivec2(gl_WorkGroupID.xy * uvec2(8u, 8u));
    vec2 invLuma = 1.0 / vec2(u_lumaWidth, u_lumaHeight);
    vec2 invFull = 1.0 / vec2(u_fullWidth, u_fullHeight);

    // 1. Load 12x12 raw luma tile (8x8 + 2px halo)
    for (uint idx = linearId; idx < 144u; idx += 64u)
    {
        uint sy = idx / 12u;
        uint sx = idx % 12u;
        ivec2 p = clamp(tileOrigin + ivec2(int(sx) - 2, int(sy) - 2), ivec2(0), ivec2(int(u_lumaWidth) - 1, int(u_lumaHeight) - 1));
        vec2 uv = (vec2(p) + 0.5) * invLuma;
        s_raw[sy][sx] = sampleBoxLuma(uv, invFull);
    }
    barrier();

    // 2. Compute 10x10 3x3 Gaussian-smoothed luma tile (8x8 + 1px halo)
    for (uint idx = linearId; idx < 100u; idx += 64u)
    {
        uint sy = idx / 10u;
        uint sx = idx % 10u;
        uint rx = sx + 1u;
        uint ry = sy + 1u;
        s_smooth[sy][sx] = (
            1.0 * s_raw[ry - 1u][rx - 1u] + 2.0 * s_raw[ry - 1u][rx] + 1.0 * s_raw[ry - 1u][rx + 1u] +
            2.0 * s_raw[ry     ][rx - 1u] + 4.0 * s_raw[ry     ][rx] + 2.0 * s_raw[ry     ][rx + 1u] +
            1.0 * s_raw[ry + 1u][rx - 1u] + 2.0 * s_raw[ry + 1u][rx] + 1.0 * s_raw[ry + 1u][rx + 1u]
        ) * (1.0 / 16.0);
    }
    barrier();

    uvec2 pos = gl_GlobalInvocationID.xy;
    if (pos.x >= u_lumaWidth || pos.y >= u_lumaHeight)
        return;

    uint cx = lid.x + 1u;
    uint cy = lid.y + 1u;
    float lCenter = s_smooth[cy][cx];
    float localNoise = abs(s_raw[cy + 1u][cx + 1u] - lCenter);
    // Adaptive noise-aware Census threshold (0.015 in clean scenes, up to 0.035 in grainy night-vision)
    float eps = clamp(0.015 + 0.5 * localNoise, 0.015, 0.035);

    uint bits = 0u;
    if (s_smooth[cy - 1u][cx - 1u] > lCenter + eps) bits |= (1u << 0u);
    if (s_smooth[cy - 1u][cx     ] > lCenter + eps) bits |= (1u << 1u);
    if (s_smooth[cy - 1u][cx + 1u] > lCenter + eps) bits |= (1u << 2u);
    if (s_smooth[cy     ][cx - 1u] > lCenter + eps) bits |= (1u << 3u);
    if (s_smooth[cy     ][cx + 1u] > lCenter + eps) bits |= (1u << 4u);
    if (s_smooth[cy + 1u][cx - 1u] > lCenter + eps) bits |= (1u << 5u);
    if (s_smooth[cy + 1u][cx     ] > lCenter + eps) bits |= (1u << 6u);
    if (s_smooth[cy + 1u][cx + 1u] > lCenter + eps) bits |= (1u << 7u);

    imageStore(dst, ivec2(pos), vec4(lCenter, float(bits) * (1.0 / 255.0), 0.0, 1.0));
}
