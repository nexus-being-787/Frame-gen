#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

#include "descriptor_set.h"

// Pass 2 (v5 Next-Level):
// Directional background-flow disocclusion inpainting (eliminates foreground object halos),
// YCoCg anti-ghosting variance clipping, static HUD/text lock, motion-adaptive RCAS-lite sharpening,
// and zero-cost 0..4ms on-screen Vulkan GPU timing bar in debug views.
layout(
  local_size_x = 8,
  local_size_y = 8,
  local_size_z = 1) in;

layout(binding = 0, scalar)
uniform layers_t {
    uint  u_width;
    uint  u_height;
    uint  u_mode;           // 1 = duplicate, 2 = blend, 3 = opticalflow
    float u_alpha;          // interpolation factor in (0.0, 1.0)
    float u_sceneCutThresh; // luma delta threshold for scene-cut fallback
    float u_flowScale;      // motion vector scale factor
    uint  u_debugMode;      // 0 = off, 1 = split A/B, 2 = flow HSV, 3 = confidence, 4 = occlusion
    float u_sharpness;      // synthetic frame RCAS-lite sharpness (0.0..1.0)
    float u_flowMs;         // Vulkan timestamp GPU time for Pass 1B flow (ms)
    float u_warpMs;         // Vulkan timestamp GPU time for Pass 2 warp (ms)
    vec4  u_hudMask;        // optional manual static HUD rect (x, y, w, h) in 0..1 UV
};

// s_samplers[0] = prevFrame (overlay-free base game frame)
// s_samplers[1] = currFrame (overlay-free base game frame)
// s_samplers[2] = frameGenFlow (RGBA16F: flowPx.x, flowPx.y, confidence, occlusion)

float luma(vec3 c)
{
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

vec3 rgbToYCoCg(vec3 c)
{
    float Co = c.r - c.b;
    float t  = c.b + 0.5 * Co;
    float Cg = c.g - t;
    float Y  = t + 0.5 * Cg;
    return vec3(Y, Co, Cg);
}

vec3 yCoCgToRgb(vec3 ycc)
{
    float t = ycc.x - 0.5 * ycc.z;
    float g = ycc.z + t;
    float b = t - 0.5 * ycc.y;
    float r = b + ycc.y;
    return clamp(vec3(r, g, b), 0.0, 1.0);
}

bool drawGpuTimingBar(uvec2 pos, uint width, float flowMs, float warpMs, out vec3 barColor)
{
    const uint barW = 240u;
    const uint barH = 18u;
    const uint pad  = 16u;
    if (width <= barW + pad * 2u)
        return false;
    uint x0 = width - barW - pad;
    uint y0 = pad;
    if (pos.x < x0 || pos.x >= x0 + barW || pos.y < y0 || pos.y >= y0 + barH)
        return false;
    uint lx = pos.x - x0;
    uint ly = pos.y - y0;
    if (lx == 0u || lx == barW - 1u || ly == 0u || ly == barH - 1u)
    {
        barColor = vec3(0.95, 0.95, 0.95);
        return true;
    }
    if (lx == 60u || lx == 120u || lx == 180u)
    {
        barColor = vec3(0.85, 0.85, 0.85);
        return true;
    }
    float msPos = (float(lx) / float(barW)) * 4.0;
    float totalMs = flowMs + warpMs;
    if (msPos <= flowMs)
        barColor = (totalMs > 4.0) ? vec3(1.0, 0.2, 0.2) : vec3(0.0, 0.85, 1.0);
    else if (msPos <= totalMs)
        barColor = (totalMs > 4.0) ? vec3(1.0, 0.1, 0.1) : vec3(0.15, 0.95, 0.35);
    else
        barColor = vec3(0.08, 0.08, 0.10);
    return true;
}

// Fix #6: Best-of-4 photometric flow upsampling picks the sharpest of the 4 nearest 1/4-res vectors
// instead of bilinearly blending foreground & background vectors across object silhouettes.
vec4 sampleBestOf4Flow(vec2 uv, vec2 invSize, float alpha)
{
    ivec2 fsz = max(textureSize(s_samplers[2], 0), ivec2(1));
    vec2 fpos = uv * vec2(fsz) - 0.5;
    ivec2 i0 = clamp(ivec2(floor(fpos)), ivec2(0), fsz - ivec2(1));
    ivec2 i1 = min(i0 + ivec2(1), fsz - ivec2(1));

    vec4 cands[4] = vec4[4](
        texelFetch(s_samplers[2], ivec2(i0.x, i0.y), 0),
        texelFetch(s_samplers[2], ivec2(i1.x, i0.y), 0),
        texelFetch(s_samplers[2], ivec2(i0.x, i1.y), 0),
        texelFetch(s_samplers[2], ivec2(i1.x, i1.y), 0)
    );

    // Early-out: if all 4 flow corners agree within 1.2px (~90% of screen), skip 8 full-res RGBA8 reads!
    vec2 d1 = cands[1].xy - cands[0].xy;
    vec2 d2 = cands[2].xy - cands[0].xy;
    vec2 d3 = cands[3].xy - cands[0].xy;
    if (max(dot(d1, d1), max(dot(d2, d2), dot(d3, d3))) < 1.44)
        return textureLod(s_samplers[2], uv, 0.0);

    vec4 best = cands[0];
    float bestErr = 1e9;
    for (int i = 0; i < 4; i++)
    {
        vec2 fv = cands[i].xy * invSize;
        float l0 = luma(textureLod(s_samplers[0], clamp(uv - fv * alpha, 0.0, 1.0), 0.0).rgb);
        float l1 = luma(textureLod(s_samplers[1], clamp(uv + fv * (1.0 - alpha), 0.0, 1.0), 0.0).rgb);
        float err = abs(l0 - l1) + (1.0 - cands[i].z) * 0.05;
        if (err < bestErr) { bestErr = err; best = cands[i]; }
    }
    return best;
}

vec3 hsv2rgb(vec3 c)
{
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

vec3 varianceClamp(vec3 sampleRgb, vec3 centerRgb, vec3 nL, vec3 nR, vec3 nU, vec3 nD, float gamma)
{
    vec3 y0 = rgbToYCoCg(centerRgb);
    vec3 yL = rgbToYCoCg(nL);
    vec3 yR = rgbToYCoCg(nR);
    vec3 yU = rgbToYCoCg(nU);
    vec3 yD = rgbToYCoCg(nD);

    vec3 m1 = (y0 + yL + yR + yU + yD) * 0.2;
    vec3 m2 = (y0 * y0 + yL * yL + yR * yR + yU * yU + yD * yD) * 0.2;
    vec3 sigma = sqrt(max(m2 - m1 * m1, vec3(0.0)));

    vec3 minC = m1 - gamma * sigma;
    vec3 maxC = m1 + gamma * sigma;
    return yCoCgToRgb(clamp(rgbToYCoCg(sampleRgb), minC, maxC));
}

void main()
{
    uvec2 pos = gl_GlobalInvocationID.xy;
    if (pos.x >= u_width || pos.y >= u_height)
        return;

    vec2 invSize = 1.0 / vec2(u_width, u_height);
    vec2 uv = (vec2(pos) + 0.5) * invSize;

    vec3 currColor = textureLod(s_samplers[1], uv, 0.0).rgb;

    if (u_mode == 1u && u_debugMode == 0u)
    {
        imageStore(dst, ivec2(pos), vec4(currColor, 1.0));
        return;
    }

    vec3 prevColor = textureLod(s_samplers[0], uv, 0.0).rgb;
    float currLuma = luma(currColor);
    float prevLuma = luma(prevColor);

    if (u_mode == 2u && u_debugMode == 0u)
    {
        float cutDelta = abs(currLuma - prevLuma);
        vec3 outColor = (cutDelta > u_sceneCutThresh) ? currColor : mix(prevColor, currColor, u_alpha);
        imageStore(dst, ivec2(pos), vec4(outColor, 1.0));
        return;
    }

    vec4 flowSample = (u_debugMode >= 2u) ? textureLod(s_samplers[2], uv, 0.0) : sampleBestOf4Flow(uv, invSize, u_alpha);
    vec2 flowPx     = flowSample.xy;
    float conf      = clamp(flowSample.z, 0.0, 1.0);
    float occl      = clamp(flowSample.w, 0.0, 1.0);

    if (u_debugMode != 0u)
    {
        vec3 barCol;
        if (drawGpuTimingBar(pos, u_width, u_flowMs, u_warpMs, barCol))
        {
            imageStore(dst, ivec2(pos), vec4(barCol, 1.0));
            return;
        }
    }

    if (u_debugMode == 2u)
    {
        float angle = atan(flowPx.y, flowPx.x);
        float hue = fract(angle / 6.28318530718);
        float mag = clamp(length(flowPx) / (20.0 * max(u_flowScale, 0.25)), 0.0, 1.0);
        vec3 flowVis = hsv2rgb(vec3(hue, 0.9, mag));
        imageStore(dst, ivec2(pos), vec4(mix(currColor * 0.25, flowVis, 0.85), 1.0));
        return;
    }

    if (u_debugMode == 3u)
    {
        vec3 heat = mix(vec3(1.0, 0.15, 0.1), vec3(0.1, 0.95, 0.25), conf);
        imageStore(dst, ivec2(pos), vec4(mix(currColor * 0.35, heat, 0.65), 1.0));
        return;
    }

    if (u_debugMode == 4u)
    {
        vec3 occVis = mix(currColor * 0.4, vec3(1.0, 0.0, 0.85), occl);
        imageStore(dst, ivec2(pos), vec4(occVis, 1.0));
        return;
    }

    // Directional Background-Flow Disocclusion Inpainting (v5):
    // When a moving foreground edge uncovers background (occl > 0.25), look 4px behind the motion vector
    // and adopt the smaller-magnitude (background) flow vector to eliminate edge halos.
    float flowMag = length(flowPx);
    if (occl > 0.25 && flowMag > 1.5)
    {
        vec2 backDir = (flowPx / flowMag) * (invSize * 4.0);
        vec2 fBehind = textureLod(s_samplers[2], clamp(uv - backDir, 0.0, 1.0), 0.0).xy;
        vec2 fAhead  = textureLod(s_samplers[2], clamp(uv + backDir, 0.0, 1.0), 0.0).xy;
        vec2 bgFlow  = (dot(fBehind, fBehind) <= dot(fAhead, fAhead)) ? fBehind : fAhead;
        if (dot(bgFlow, bgFlow) < dot(flowPx, flowPx))
            flowPx = mix(flowPx, bgFlow, smoothstep(0.25, 0.75, occl) * 0.85);
    }

    // Bidirectional motion-compensated sampling
    vec2 flowUV = flowPx * invSize;
    vec2 uvPrev = clamp(uv - flowUV * u_alpha, vec2(0.0), vec2(1.0));
    vec2 uvCurr = clamp(uv + flowUV * (1.0 - u_alpha), vec2(0.0), vec2(1.0));

    vec3 warpedPrev = textureLod(s_samplers[0], uvPrev, 0.0).rgb;
    vec3 warpedCurr = textureLod(s_samplers[1], uvCurr, 0.0).rgb;

    // Single shared 4-neighbor cross reused for YCoCg anti-ghosting, HUD protection, and RCAS-lite
    vec3 nL = textureLod(s_samplers[1], clamp(uvCurr - vec2(invSize.x, 0.0), 0.0, 1.0), 0.0).rgb;
    vec3 nR = textureLod(s_samplers[1], clamp(uvCurr + vec2(invSize.x, 0.0), 0.0, 1.0), 0.0).rgb;
    vec3 nU = textureLod(s_samplers[1], clamp(uvCurr - vec2(0.0, invSize.y), 0.0, 1.0), 0.0).rgb;
    vec3 nD = textureLod(s_samplers[1], clamp(uvCurr + vec2(0.0, invSize.y), 0.0, 1.0), 0.0).rgb;

    float edgeContrast = max(max(abs(currLuma - luma(nL)), abs(currLuma - luma(nR))),
                             max(abs(currLuma - luma(nU)), abs(currLuma - luma(nD))));
    float staticDelta = length(currColor - prevColor);
    float hudProtect = (1.0 - smoothstep(0.008, 0.025, staticDelta)) * smoothstep(0.08, 0.22, edgeContrast);

    vec3 clampedPrev = varianceClamp(warpedPrev, warpedCurr, nL, nR, nU, nD, 1.20);

    float warpErr = abs(luma(warpedPrev) - luma(warpedCurr));
    float particlePop = smoothstep(0.22, 0.45, staticDelta) * smoothstep(0.10, 0.28, warpErr);
    float photoConf = 1.0 - smoothstep(0.04, 0.20, warpErr);
    float totalConf = conf * photoConf * (1.0 - particlePop * 0.85);

    float errPrev = abs(luma(clampedPrev) - prevLuma);
    float errCurr = abs(luma(warpedCurr) - currLuma);
    vec3 occlSafe = (errCurr <= errPrev) ? warpedCurr : clampedPrev;

    vec3 motionComp = mix(mix(clampedPrev, warpedCurr, u_alpha), occlSafe, occl * 0.75);
    vec3 fallback   = (abs(currLuma - prevLuma) > u_sceneCutThresh)
        ? currColor
        : mix(prevColor, currColor, u_alpha);

    vec3 interpColor = mix(fallback, motionComp, totalConf);
    if (u_hudMask.z > 0.0 && u_hudMask.w > 0.0 &&
        uv.x >= u_hudMask.x && uv.x <= u_hudMask.x + u_hudMask.z &&
        uv.y >= u_hudMask.y && uv.y <= u_hudMask.y + u_hudMask.w)
        hudProtect = 1.0;
    interpColor = mix(interpColor, currColor, hudProtect);

    // Motion-adaptive RCAS-lite sharpening: sharp on slow/still scenes, gentle on fast motion to prevent shimmer
    if (u_sharpness > 0.01)
    {
        float motionDamp = 1.0 - 0.55 * smoothstep(4.0, 20.0, flowMag);
        vec3 avgN = 0.25 * (nL + nR + nU + nD);
        vec3 detail = interpColor - avgN;
        float localContrast = max(max(abs(detail.r), abs(detail.g)), abs(detail.b));
        float adaptiveGain = u_sharpness * motionDamp * (1.0 - smoothstep(0.15, 0.45, localContrast));
        interpColor = clamp(interpColor + detail * adaptiveGain, 0.0, 1.0);
    }

    if (u_debugMode == 1u)
    {
        uint midX = u_width / 2u;
        if (pos.x + 1u >= midX && pos.x <= midX + 1u)
        {
            imageStore(dst, ivec2(pos), vec4(0.0, 1.0, 0.9, 1.0));
            return;
        }
        vec3 splitOut = (pos.x < midX) ? currColor : interpColor;
        imageStore(dst, ivec2(pos), vec4(splitOut, 1.0));
        return;
    }

    imageStore(dst, ivec2(pos), vec4(interpColor, 1.0));
}
